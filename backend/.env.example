# Backend Environment Variables
# Copy this file to .env and fill in the values

# MongoDB - Get free tier at https://www.mongodb.com/cloud/atlas
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/the_dirt_place?retryWrites=true&w=majority
DB_NAME=the_dirt_place

# Admin password for dashboard
ADMIN_PASSWORD=dirtplace2024

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=*

# Resend - Get free API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Stripe - get keys at https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Google Maps - get key at https://console.cloud.google.com/apis/credentials
# GOOGLE_MAPS_API_KEY=your_key_here
# DIRTPLACE_ADDRESS=240 TX-46, Boerne, TX 78006

# Cloudflare R2 - get from Cloudflare Dashboard > R2 > Bucket > Connect
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=the-dirt-place
# R2_ACCOUNT_ID=c12ef03d29310fceb5fe71e1cae66cf7
# R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# Texas Tax & Fees (defaults)
# TEXAS_TAX_RATE=0.0825
# CARD_ADMIN_FEE_RATE=0.035
# DELIVERY_FEE_BASE=70
# DELIVERY_FEE_PER_MILE=5