# Backend Environment Variables
# Copy this file to .env and fill in the values

# MongoDB - Get free tier at https://www.mongodb.com/cloud/atlas
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/the_dirt_place?retryWrites=true&w=majority
DB_NAME=the_dirt_place

# Admin password for dashboard
ADMIN_PASSWORD=dirtplace2024

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=*

# Resend - Get free API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxx